# ==============================================================================
# SamIT Launchpad — Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace every placeholder with a real value.
#   cp .env.example .env
#
# RULES:
#   1. Only VITE_* variables are exposed to the browser bundle. Never prefix a
#      backend secret with VITE_.
#   2. Never commit your actual .env file. It is already in .gitignore.
#   3. In Vercel/Netlify, set these via the platform's Environment Variables UI,
#      NOT by uploading a .env file.
# ==============================================================================


# ------------------------------------------------------------------------------
# Contact Form — Google Apps Script Web App
# ------------------------------------------------------------------------------
# Deploy your Apps Script as a Web App (Execute as: Me, Who has access: Anyone).
# Copy the /exec deployment URL here.
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
#
VITE_FORM_API_URL=https://script.google.com/macros/s/AKfycbzJf1jyGivEyvVhZ5pW1VbuBgGnqcg2ID8MCkyS7yb8Qd8i1NtuLCX5bBAetBWUAm3hHQ/exec


# ------------------------------------------------------------------------------
