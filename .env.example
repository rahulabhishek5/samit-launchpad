# ==============================================================================
# SamIT Launchpad — Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace every placeholder with a real value.
#   cp .env.example .env
#
# RULES:
#   1. Only VITE_* variables are exposed to the browser bundle. Never prefix a
#      backend secret with VITE_.
#   2. Never commit your actual .env file. It is already in .gitignore.
#   3. In Vercel/Netlify, set these via the platform's Environment Variables UI,
#      NOT by uploading a .env file.
# ==============================================================================


# ------------------------------------------------------------------------------
# Contact Form — Google Apps Script Web App
# ------------------------------------------------------------------------------
# Deploy your Apps Script as a Web App (Execute as: Me, Who has access: Anyone).
# Copy the /exec deployment URL here.
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
#
VITE_FORM_API_URL=REPLACE_WITH_YOUR_GOOGLE_APPS_SCRIPT_EXEC_URL


# ------------------------------------------------------------------------------
# Contact — Communication Anchors
# ------------------------------------------------------------------------------
# The phone, email, WhatsApp, and Maps links displayed on the Contact section.
# Update these when the client's contact details change without touching source.
#
VITE_CONTACT_PHONE=REPLACE_WITH_DISPLAY_PHONE_NUMBER
VITE_CONTACT_PHONE_TEL=REPLACE_WITH_TEL_URI_PHONE_NUMBER
VITE_CONTACT_EMAIL=REPLACE_WITH_CONTACT_EMAIL_ADDRESS
VITE_CONTACT_EMAIL_HREF=REPLACE_WITH_MAILTO_URI
VITE_CONTACT_WHATSAPP_HREF=REPLACE_WITH_WHATSAPP_API_URL
VITE_CONTACT_MAPS_HREF=REPLACE_WITH_GOOGLE_MAPS_URL


# ------------------------------------------------------------------------------
# Social Media Links (Footer)
# ------------------------------------------------------------------------------
VITE_SOCIAL_LINKEDIN=REPLACE_WITH_LINKEDIN_PROFILE_URL
VITE_SOCIAL_INSTAGRAM=REPLACE_WITH_INSTAGRAM_PROFILE_URL
VITE_SOCIAL_FACEBOOK=REPLACE_WITH_FACEBOOK_PAGE_URL


# ------------------------------------------------------------------------------
# (Future) Analytics / Tracking
# ------------------------------------------------------------------------------
# Uncomment and fill when integrating:
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_HOTJAR_ID=0000000


# ------------------------------------------------------------------------------
# ⚠ NEVER ADD THESE HERE ⚠
# ------------------------------------------------------------------------------
# Do NOT place any of the following in this file or any .env.* committed to
# source control:
#
#   - Database connection strings (Postgres, MongoDB URIs, etc.)
#   - Private API keys (OpenAI, Stripe secret keys, Twilio auth tokens, etc.)
#   - OAuth client secrets / JWT signing secrets
#   - Cloud IAM credentials (AWS_SECRET_ACCESS_KEY, GCP service account JSON)
#   - Firebase Admin SDK private keys
#
# These must only exist in a server-side runtime environment (e.g., Vercel
# serverless function env, GitHub Actions secrets, or a backend .env that is
# NEVER committed).
# ==============================================================================
